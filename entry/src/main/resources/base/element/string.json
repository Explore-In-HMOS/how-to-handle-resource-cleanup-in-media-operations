      "name": "detail_clean_playback",
      "value": "Plays a tone for 3 s, then releases the player and closes the rawfile fd, in that order."
    },
    {
      "name": "detail_missing_file",
      "value": "Requests a rawfile that does not exist. getRawFd() fails before any fd exists, so cleanup releases the player and skips closeRawFd()."
    },
    {
      "name": "detail_corrupt_file",
      "value": "Opens a text file with an .mp3 extension. prepare() fails after the fd is open, so cleanup must still close it, exactly once."
    },
    {
      "name": "detail_double_release",
      "value": "Part A calls release() twice without a guard and fails with 5400102. Part B starts two releases at once; cleanup runs once."
    },
    {
      "name": "detail_record_play",
      "value": "Records 3 s, releases the recorder and closes its fd, then plays the recording."
    },
    {
      "name": "detail_failed_record",
